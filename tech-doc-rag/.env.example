# tech-doc-rag environment template
# The current app uses local FAISS, DDG web search, and in-app TRACE events.

USE_LOCAL_VECTORSTORE=true
FAISS_INDEX_PATH=.faiss_index

# Mock mode lets local smoke tests run without provider credentials.
MOCK_LLM=true

# LLM: any OpenAI-compatible chat endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# Embeddings: Hugging Face sentence-transformers by default, no key required.
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text

TOP_K=3
MAX_RETRIES=2
MAX_TOOL_ITERATIONS=10
FAST_MODE=false
ENABLE_GRADING=true
STREAM_CHUNK_DELAY=0.025
STREAM_CHUNK_SIZE=4
TRACE_TEXT_LIMIT=1200
TRACE_RESULT_LIMIT=2000
MAX_UPLOAD_BYTES=2000000
MAX_UPLOAD_SESSION_ID_LENGTH=128

# Not required by the current implementation:
# PINECONE_API_KEY, TAVILY_API_KEY, LANGCHAIN_API_KEY
