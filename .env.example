# Environment variables template
# Copy this file to .env and fill in values for your local or hosted runtime.

# Current vector store path: local FAISS, no API key required.
USE_LOCAL_VECTORSTORE=true
FAISS_INDEX_PATH=.faiss_index

# Mock LLM mode is useful for smoke tests without provider credentials.
# Set to false for real local or production answers.
MOCK_LLM=true

# LLM: any OpenAI-compatible chat endpoint.
# Examples:
# - Ollama local: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama
# - OpenRouter/OpenAI/Groq/Together: set provider base URL, key, and model.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# Embeddings: Hugging Face sentence-transformers by default, no key required.
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=

# Retrieval and graph controls.
TOP_K=3
MAX_RETRIES=2
MAX_TOOL_ITERATIONS=10
FAST_MODE=false
ENABLE_GRADING=true

# SSE streaming controls.
STREAM_CHUNK_DELAY=0.025
STREAM_CHUNK_SIZE=4
TRACE_TEXT_LIMIT=1200
TRACE_RESULT_LIMIT=2000

# Public demo upload controls.
MAX_UPLOAD_BYTES=2000000
MAX_UPLOAD_SESSION_ID_LENGTH=128

# FastAPI / browser settings.
APP_NAME=Agentic RAG Portfolio
DEBUG=false
CORS_ORIGINS=['*']
API_URL=http://localhost:8000

# Not required for the current stack:
# - PINECONE_API_KEY / Pinecone index setup
# - TAVILY_API_KEY
# - LANGCHAIN_API_KEY / LangSmith tracing
# The current app uses FAISS, DDG web search, and in-app TRACE events.
